	link,nn6000-v1|\
	link,nn6000-v2)
		local cfgpart part_ker part_root
		cfgpart=$(find_mmc_part "0:BOOTCONFIG")
		part_ker="$(hexdump -e '1/1 "%01x|"' -n 1 -s 128 -C "$cfgpart" | cut -f 1 -d "|" | head -n1)"
		part_root="$(hexdump -e '1/1 "%01x|"' -n 1 -s 148 -C "$cfgpart" | cut -f 1 -d "|" | head -n1)"
		case "$part_ker:$part_root" in
			0:0|1:1)
				;;
			*)
				echo "ERROR: BOOTCONFIG slot mismatch (0:HLOS=$part_ker, rootfs=$part_root)" >&2
				echo "       refuse to flash: kernel and rootfs would land on different slots" >&2
				return 1
				;;
		esac
		if [ "$part_ker" -eq "1" ]; then
			CI_KERNPART="0:HLOS_1"
		else
			CI_KERNPART="0:HLOS"
		fi
		if find_mmc_part "rootfs_1" >/dev/null 2>&1; then
			if [ "$part_root" -eq "1" ]; then
				CI_ROOTPART="rootfs_1"
			else
				CI_ROOTPART="rootfs"
			fi
		else
			CI_ROOTPART="rootfs"
		fi
		if [ "$SAVE_CONFIG" = "0" ]; then
			local ovl squash_kb off rootdev
			ovl="$(find_mmc_part "rootfs_data" 2>/dev/null)"
			if [ -n "$ovl" ]; then
				dd if=/dev/zero of="$ovl" bs=4096 count=256 2>/dev/null
				sync
			else
				rootdev="$EMMC_ROOT_DEV"
				[ -n "$rootdev" ] || rootdev="$(find_mmc_part "$CI_ROOTPART" "$CI_ROOTDEV")"
				squash_kb="$(df -k /rom 2>/dev/null | awk 'NR==2 {print $2}')"
				if [ -n "$rootdev" ] && [ -n "$squash_kb" ] && [ "$squash_kb" -gt 0 ] 2>/dev/null; then
					off=$(( (squash_kb * 1024 + 4095) / 4096 * 4096 ))
					dd if=/dev/zero of="$rootdev" bs=4096 \
						seek=$(( off / 4096 )) count=256 2>/dev/null
					sync
				fi
			fi
		fi
		emmc_do_upgrade "$1"
		;;
