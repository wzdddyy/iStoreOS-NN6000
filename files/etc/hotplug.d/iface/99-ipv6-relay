#!/bin/sh
# Dynamically switch IPv6 relay config based on WAN protocol.
# Triggered when WAN interface comes up.

[ "$INTERFACE" = "wan" ] || exit 0
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0

# Avoid re-entrancy loops
[ -f /tmp/.ipv6-relay-busy ] && exit 0

wan_proto=$(uci -q get network.wan.proto)

if [ "$wan_proto" = "dhcp" ]; then
    # Already in relay mode?
    [ "$(uci -q get dhcp.wan.ra)" = "relay" ] && exit 0

    touch /tmp/.ipv6-relay-busy
    uci -q delete network.wan.ipv6
    uci -q delete network.lan.ipv6
    uci set network.lan.ip6assign='64'
    uci set dhcp.wan.master='1'
    uci set dhcp.wan.ra='relay'
    uci set dhcp.wan.dhcpv6='relay'
    uci set dhcp.wan.ndp='relay'
    uci set dhcp.lan.ra='hybrid'
    uci set dhcp.lan.dhcpv6='hybrid'
    uci set dhcp.lan.ndp='hybrid'
    uci -q delete dhcp.lan.ra_slaac
    uci commit network
    uci commit dhcp
    /etc/init.d/odhcpd restart
    rm -f /tmp/.ipv6-relay-busy
else
    # Already in default (PPPoE/server) mode?
    [ -z "$(uci -q get dhcp.wan.ra)" ] && \
    [ "$(uci -q get dhcp.lan.ra)" = "server" ] && exit 0

    touch /tmp/.ipv6-relay-busy
    uci -q delete network.wan.ipv6
    uci -q delete network.lan.ipv6
    uci set network.lan.ip6assign='60'
    uci -q delete dhcp.wan.master
    uci -q delete dhcp.wan.ra
    uci -q delete dhcp.wan.dhcpv6
    uci -q delete dhcp.wan.ndp
    uci set dhcp.lan.ra='server'
    uci set dhcp.lan.dhcpv6='server'
    uci -q delete dhcp.lan.ndp
    uci set dhcp.lan.ra_slaac='1'
    uci commit network
    uci commit dhcp
    /etc/init.d/odhcpd restart
    rm -f /tmp/.ipv6-relay-busy
fi
